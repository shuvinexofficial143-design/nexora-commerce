# NEXORA local / deployment environment
DATABASE_URL=
DIRECT_URL=

# Public customer accounts are disabled by default; guest checkout stays active.
PUBLIC_CUSTOMER_AUTH_ENABLED=false
# Multi-vendor seller workspace is disabled for this personal store.
MULTI_VENDOR_ENABLED=false

# Private single-owner admin login
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional display/audit identity for the owner admin user.
ADMIN_OWNER_EMAIL=owner@nexora.local

# Existing integrations
ADMIN_APP_ORIGINS=
GROQ_API_KEY=
GROQ_MODEL=
NEXT_PUBLIC_APP_URL=

# Cashfree Payment Gateway
# Keep NEXT_PUBLIC_CASHFREE_ENABLED=false until the keys and callback URL are ready.
NEXT_PUBLIC_CASHFREE_ENABLED=false
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Optional override; normally leave blank.
CASHFREE_API_BASE=

# Cloudinary direct product media uploads
# API secret stays server-side; browser receives only a short-lived upload signature.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Customer order emails (optional)
# If these are blank, checkout and order updates still work; emails are simply skipped.
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_SUPPORT_EMAIL=

# Public business/contact identity
STORE_DISPLAY_NAME=NEXORA
STORE_LEGAL_NAME=
STORE_SUPPORT_EMAIL=
STORE_SUPPORT_PHONE=
STORE_WHATSAPP_NUMBER=
STORE_BUSINESS_ADDRESS=
STORE_GSTIN=
